# Copy to .env.local (gitignored) and fill in. NEVER commit filled values.
# Preferred path is the DPAPI vault: `opencode-voice vault set <groq|fish> --from-prompt`.
OPENCODE_SERVER_PASSWORD=
GROQ_API_KEYS=
FISH_AUDIO_KEYS=
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1
VOICE_DEFAULT=male
BRAIN_GOLDEN_MS=2000
BRAIN_CEILING_MS=5000
TTS_CACHE_SIZE=50
LOG_LEVEL=info
CAPTURE_MODE=push-to-talk
BRIEFINGS=bluf
QUIET_HOURS=22:00-07:00
MUTE_ON_CALL=on
MIC_DEFAULT=armed
