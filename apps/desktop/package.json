{
  "name": "voxaura",
  "private": true,
  "version": "0.7.1",
  "description": "Voxaura — sovereign ambient voice and agentic desktop shell for opencode-voice-runtime.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
