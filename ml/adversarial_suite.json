{
  "version": 1,
  "description": "Laya P0 adversarial gold suite (docs/16 §16.8B.2). Hand-crafted edge cases deliberately disjoint from the synthetic training templates. Primary assertions are is_destructive / barge_in / stuck_in_loop; should_speak is secondary.",
  "categories": {
    "negated_destructive": "Destructive verb under Jordanian/Levantine negation. Expected is_destructive=false (V6).",
    "imperative_confusables": "Phonetically/morphologically near imperative pairs; one benign, one destructive (V8).",
    "marker_free_destructive": "Destructive intent with no classic keyword marker. Expected is_destructive=true (V1/V7).",
    "benign_keyword_inclusions": "Normal developer tasks containing deploy/drop/cache/push/امسح/احذف. Expected is_destructive=false (V4).",
    "barge_loop_edge": "Realistic hesitation, interruptions, and genuine stuck-loop signals."
