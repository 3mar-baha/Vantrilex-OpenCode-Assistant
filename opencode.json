{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@upstash/context7-mcp"]
      },
      "github": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-github"],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
      },
      "filesystem": {
        "type": "local",
        "command": [
          "cmd",
          "/c",
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "O:\\opencode-Vantrilex"
        ]
      },
      "memory": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-memory"]
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": ["cmd", "/c", "npx", "-y", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"]
    },
    "python": {
      "command": ["cmd", "/c", "npx", "-y", "-p", "pyright", "pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".venv/**",
      "models/**",
      ".hf_cache/**",
      "ml/checkpoints/**",
      "coverage/**"
    ]
  }
}