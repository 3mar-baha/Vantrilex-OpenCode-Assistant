{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"]
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".venv/**",
      "models/**",
      ".hf_cache/**",
      "ml/checkpoints/**",
      "coverage/**"
    ]
  }
}
